{
  "name": "tylan",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "bun run build:viewer && vite",
    "build:viewer": "vite build --mode viewer",
    "sample": "bun scripts/make-sample.ts",
    "build": "bun scripts/build.ts",
    "preview": "vite preview",
    "check": "svelte-check --tsgo --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "test:release": "vitest run --config vitest.release.config.ts",
    "test:collector": "bun scripts/test-collector.ts",
    "format": "biome format --write .",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "verify": "bun run lint && bun run check && bun run test && bun run test:collector && bun run build && bun run test:release"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^26.6.6",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/browser-playwright": "5.1.0",
    "playwright": "1.64.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "6.0.3",
    "vite": "^8.3.5",
    "vitest": "5.1.0",
    "vitest-browser-svelte": "3.1.0"
  },
  "dependencies": {
    "@xyflow/svelte": "^1.7.1",
    "html-to-image": "1.11.13",
    "zod": "^4.6.7"
  }
}
