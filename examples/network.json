    "version": "2026-11",
    "items": [
      {
        "no": 1,
        "category": "機器・設置",
        "title": "サービスアダプタ",
        "content": "IIJサービスアダプタの設置場所、型番、シリアル番号、ランプ状態を確認",
        "method": "現物・ラベルを確認"
      },
      {
        "no": 2,
        "category": "機器・設置",
        "title": "スイッチ",
        "content": "L2スイッチのメーカー、型番、台数、設置場所、管理可否を確認",
        "method": "現物・管理画面を確認"
      },
      {
        "no": 3,
        "category": "機器・設置",
        "title": "無線AP",
        "content": "無線AP・中継器の台数、型番、設置場所を確認",
        "method": "現物と設置場所を確認"
      },
      {
        "no": 4,
        "category": "機器・設置",
        "title": "非承認機器",
        "content": "私物ルーター、ハブ、無断AP、テザリング機器の常設がないか",
        "method": "現場担当者へ聞き取り・目視"
      },
      {
        "no": 5,
        "category": "機器・設置",
        "title": "旧設備",
        "content": "旧NEC機器・旧AP・使われないハブなどの接続、残置を確認",
        "method": "現物・接続を確認"
      },
      {
        "no": 6,
        "category": "機器・設置",
        "title": "機器管理",
        "content": "設置機器の所有者、管理担当者、保守窓口を確認",
        "method": "担当者へ聞き取り"
      },
      {
        "no": 7,
        "category": "配線・物理構成",
        "title": "接続構成",
        "content": "サービスアダプタ→スイッチ→AP・端末等の接続関係を記録",
        "method": "ケーブルを追跡し構成図を起こす"
      },
      {
        "no": 8,
        "category": "配線・物理構成",
        "title": "ポート",
        "content": "スイッチの使用ポート、空きポート、用途不明ポートを確認",
        "method": "ポート番号と接続先を記録"
      },
      {
        "no": 12,
        "category": "IP・DHCP・DNS",
        "title": "アドレス設計",
        "content": "拠点LANのIPアドレス帯、サブネット、デフォルトGWを把握",
        "method": "管理設定・代表端末で確認"
      },
      {
        "no": 13,
        "category": "IP・DHCP・DNS",
        "title": "DHCP",
        "content": "DHCPの配布元、配布範囲、除外範囲、リース設定を確認",
        "method": "ルーター設定・代表端末で確認"
      },
      {
        "no": 14,
        "category": "IP・DHCP・DNS",
        "title": "不審なDHCP",
        "content": "管理外のDHCPサーバ、二重配布の兆候がないか",
